<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\*.cs" Exclude="..\ParseHRTF.cs;..\AssemblyInfo.cs" />
    <Compile Include="*.cs;SofaStub\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MIConvexHullDll)' == ''">
    <PackageReference Include="MIConvexHull" Version="1.1.19.1019" />
  </ItemGroup>
  <ItemGroup Condition="'$(MIConvexHullDll)' != ''">
    <Reference Include="MIConvexHull"><HintPath>$(MIConvexHullDll)</HintPath></Reference>
  </ItemGroup>
</Project>
